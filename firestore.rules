rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return signedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    function isActiveUser() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'));
    }

    function hasRole(role) {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDirector() {
      return hasRole('director');
    }

    function isViceDirector() {
      return hasRole('vice_director');
    }

    function isExecutive() {
      return isDirector() || isViceDirector() || isAdmin();
    }

    function isManager() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && (p.role == 'manager');
    }

    function isStaff() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role in ['director', 'vice_director', 'admin', 'manager', 'instructor', 'instructorleader', 'instructor_leader', 'marketing', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'officeboy'];
    }

    function isFrontOffice() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role in ['frontoffice', 'opslead', 'ops_lead', 'frontofficelead'];
    }

    function isOpsLead() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role in ['opslead', 'ops_lead', 'frontofficelead'];
    }

    function isFrontDeskStaff() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role in ['frontoffice'];
    }

    // Instructor Leader (academic branch-scope leadership). Accepts the canonical
    // role and the legacy alias, exactly like isApproverForDoc does.
    //
    // Authorization note (owner-approved 2026-10-08): this helper grants READ
    // authority only, and only for academic monitoring collections
    // (progressReports, classAttendance) at branch scope. It deliberately does NOT
    // grant shift-record access, because shift documents carry cashReconciliation
    // fields and Firestore rules cannot restrict which fields a read returns.
    // See docs/reports/instructor-leader-dashboard/01-phase1-completion-report.md.
    function isInstructorLeader() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role in ['instructorleader', 'instructor_leader'];
    }

    function userBranch() {
      let p = userProfile();
      return signedIn() && p != null && ('branchId' in p)
        ? p.branchId
        : (signedIn() && p != null && ('branch' in p)
          ? (
            (p.branch == 'Bone Bolango' ? 'bone_bolango' :
            p.branch == 'Pohuwato' ? 'pohuwato' :
            p.branch == 'Limboto' ? 'limboto' :
            p.branch == 'Kota Gorontalo' || p.branch == 'Cabang Utama' ? 'kota_gorontalo' : null)
          )
          : null);
    }

    function isSameBranch(data) {
      let ub = userBranch();
      return isExecutive() || (signedIn() && ub != null && (
        (data != null && 'branchId' in data && data.branchId == ub) ||
        (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && ub == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && ub == 'pohuwato') ||
          (data.branch == 'Limboto' && ub == 'limboto') ||
          (data.branch == 'Cabang Utama' && ub == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && ub == 'kota_gorontalo')
        )) ||
        (data != null && !('branchId' in data) && !('branch' in data) && ub == 'kota_gorontalo')
      ));
    }

    // For `list` only: isSameBranch's no-branch-fields -> kota_gorontalo fallback
    // is unsound there. List rules are evaluated against a synthetic document
    // built from the query's where clauses, so a query with no branch filter
    // produces a fieldless synthetic doc that the fallback treats as Kota
    // Gorontalo — letting Kota Gorontalo staff list every branch's documents.
    // get/update/delete keep the lenient form so legacy branchless docs stay
    // readable/writable to Kota Gorontalo staff.
    function isSameBranchStrict(data) {
      let ub = userBranch();
      return signedIn() && ub != null && (
        (data != null && 'branchId' in data && data.branchId == ub)
        || (data != null && !('branchId' in data) && 'branch' in data && (
          (data.branch == 'Bone Bolango' && ub == 'bone_bolango') ||
          (data.branch == 'Pohuwato' && ub == 'pohuwato') ||
          (data.branch == 'Limboto' && ub == 'limboto') ||
          (data.branch == 'Cabang Utama' && ub == 'kota_gorontalo') ||
          (data.branch == 'Kota Gorontalo' && ub == 'kota_gorontalo')
        ))
      );
    }

    // Division scope helpers for branch staff (manager & front office)
    function userDivision() {
      let p = userProfile();
      return signedIn() && p != null && ('division' in p) ? p.division : null;
    }

    function isSameDivisionStrict(data) {
      return data != null && ('division' in data) && data.division == userDivision();
    }

    function isDivisionAllowedForBranchStaff(data) {
      let p = userProfile();
      let role = p != null && 'role' in p ? p.role : '';
      let isStaffRole = role in ['manager', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing'];
      let uDiv = userDivision();
      return !isStaffRole
        || (uDiv == 'all')
        || (uDiv == 'kindergarten'
          ? (data != null && 'division' in data && data.division == 'kindergarten')
          : (!('division' in data) || data.division != 'kindergarten'));
    }

    function isDivisionAllowedForManager(data) {
      return isDivisionAllowedForBranchStaff(data);
    }

    // ── Ratified gate registry binding (actionId -> permitted approverRole) ──
    // Mirrors GATED_ACTIONS[*].eligibleApproverRoles in src/features/shared/approvalGates.js,
    // ratified by Blueprint v3.3 §26 (G-006 / G-007). Legacy alias spellings are accepted so
    // existing documents keep working; canonical values remain preferred.
    //
    // Why this exists: isApproverForDoc previously validated only the document's own
    // approverRole field, so whoever wrote the envelope chose who could approve it. A probe
    // proved an Instructor Leader could decide a CASH_DISCREPANCY ticket merely by addressing
    // it to themselves. See docs/reports/instructor-leader-dashboard/01-phase1-completion-report.md §6.5.
    //
    // Written as a short-circuiting `||` chain rather than a map of lists on purpose: a map
    // literal constructs every list on every call, which exhausted the rules engine's
    // 1000-expression evaluation budget ("Unable to evaluate the expression as the maximum of
    // 1000 expressions to evaluate has been reached"). Each clause here evaluates only after
    // its actionId equality matches.
    //
    // Deliberately NOT called from isApproverForDoc: that helper also backs the read path, and
    // the binding only needs to gate decisions (update) and consumption. Fails closed.
    //
    // Keep in sync with securityRulesMatrix.helpers.js -> GATE_APPROVER_ROLES / gateAllowsApprover().
    function gateAllowsApprover(actionId, approverRole) {
      return (actionId == 'STAFF_ROLE_ELEVATION' && (approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'NEW_STAFF_ACCOUNT' && (approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'STAFF_DEACTIVATION' && (approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'DISCOUNT_OR_REFUND' && (approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'TUITION_PLAN_CHANGE' && (approverRole == 'manager' || approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'STUDENT_WITHDRAWAL_OR_FREEZE' && (approverRole == 'manager' || approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'CASH_DISCREPANCY' && (approverRole == 'opslead' || approverRole == 'ops_lead' || approverRole == 'manager' || approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'PLACEMENT_LEVEL_OVERRIDE' && (approverRole == 'instructorleader' || approverRole == 'instructor_leader'))
        || (actionId == 'SUBSTITUTE_INSTRUCTOR' && (approverRole == 'instructorleader' || approverRole == 'instructor_leader'))
        || (actionId == 'CLASS_CANCELLATION_OR_RESCHEDULE' && (approverRole == 'opslead' || approverRole == 'ops_lead'))
        || (actionId == 'RETROACTIVE_STUDENT_ATTENDANCE' && (approverRole == 'opslead' || approverRole == 'ops_lead'))
        || (actionId == 'STUDENT_CLASS_TRANSFER' && (approverRole == 'opslead' || approverRole == 'ops_lead'))
        || (actionId == 'STAFF_SHIFT_SELF_CORRECTION' && (approverRole == 'opslead' || approverRole == 'ops_lead' || approverRole == 'manager' || approverRole == 'director' || approverRole == 'vice_director'))
        || (actionId == 'STAFF_STATUS_CHANGE' && (approverRole == 'opslead' || approverRole == 'ops_lead' || approverRole == 'instructorleader' || approverRole == 'instructor_leader' || approverRole == 'manager' || approverRole == 'director' || approverRole == 'vice_director'));
    }

    function isApproverForDoc(data) {
      let targetRole = data != null && 'approverRole' in data ? data.approverRole : 'manager';
      let roleMatches = ((targetRole == 'director' || targetRole == 'vice_director') && (isDirector() || isViceDirector()))
        || (targetRole == 'manager' && (isManager() || isDirector() || isViceDirector()))
        || ((targetRole == 'instructor_leader' || targetRole == 'instructorleader') && (hasRole('instructorleader') || hasRole('instructor_leader')))
        || ((targetRole == 'ops_lead' || targetRole == 'opslead') && isOpsLead())
        || (targetRole == 'frontoffice' && isFrontOffice());
      // Approval docs route by approverBranchId (see approvalGates.js); fall back
      // to the generic branch fields for legacy docs.
      let branchMatches = (isDirector() || isViceDirector()) || (data != null && 'approverBranchId' in data
        ? data.approverBranchId == userBranch()
        : isSameBranch(data));
      return roleMatches && branchMatches;
    }

    function roleOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.role;
    }

    function isTrackedShiftRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin', 'manager'];
    }

    function isTrackedLeaveRole(r) {
      return r in ['instructor', 'instructorleader', 'instructor_leader', 'frontoffice', 'opslead', 'ops_lead', 'frontofficelead', 'marketing', 'officeboy', 'admin'];
    }

    function isInviteValid(inviteId) {
      let inv = get(/databases/$(database)/documents/invites/$(inviteId)).data;
      return inv.email == request.auth.token.email.lower()
          && inv.role == request.resource.data.role
          && (!('expiresAt' in inv) || inv.expiresAt > request.time.toMillis())
          && (!('branchId' in inv) || request.resource.data.branchId == inv.branchId)
          && (!('division' in inv) || request.resource.data.division == inv.division);
    }

    function isApprovedShiftCorrection(shiftId, approvalId) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'STAFF_SHIFT_SELF_CORRECTION'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        // The approver must be a role permitted for THIS gate. The actionId is already pinned
        // to STAFF_SHIFT_SELF_CORRECTION above, so the permitted set is inlined rather than
        // running the generic gateAllowsApprover chain — that chain pushed this update rule
        // past the rules engine's 1000-expression evaluation budget.
        && ('approverRole' in approval)
        && (approval.approverRole in ['opslead', 'ops_lead', 'manager', 'director', 'vice_director'])
        && 'payload' in approval
        && approval.payload != null
        && approval.payload.shiftId == shiftId;
    }

    function isApprovedRoleElevation(targetUserId, approvalId, targetRole) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'STAFF_ROLE_ELEVATION'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        && 'payload' in approval
        && approval.payload != null
        && approval.payload.targetUserId == targetUserId
        && approval.payload.targetRole == targetRole
        && approval.requestedByUid != approval.decidedByUid
        && approval.decidedByUid != targetUserId
        && ('approverRole' in approval)
        && (approval.approverRole in ['director', 'vice_director']);
    }

    // ── Placement level authority (OD-IL-ENF2, design A′; owner-ratified 2026-10-08) ──
    // An ordinary placement assessment may only set `currentLevel` to the level the score
    // recorded in the same write actually implies. Any other level is an override and
    // needs an approved PLACEMENT_LEVEL_OVERRIDE envelope. Without this, "blocking" was a
    // label only: the client wrote the override immediately and rejecting the leader's
    // ticket changed nothing.
    //
    // The rubric mirrors src/constants/levels.js -> recommendLevelFromScore(), which is
    // the single source of truth; src/features/shared/placementLevelGate.test.js fails if
    // the two drift apart.
    function scoreImpliedLevel(score) {
      return score >= 85 ? 'epic' : (score >= 65 ? 'master' : 'warrior');
    }

    function isApprovedPlacementLevelOverride(inquiryId, approvalId, level) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'PLACEMENT_LEVEL_OVERRIDE'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        && approval.requestedByUid != approval.decidedByUid
        && ('approverRole' in approval)
        // The actionId is pinned above, so the permitted set is inlined rather than
        // running the generic gateAllowsApprover chain (rules-engine expression budget).
        && (approval.approverRole == 'instructorleader' || approval.approverRole == 'instructor_leader')
        && ('payload' in approval)
        && approval.payload != null
        && approval.payload.inquiryId == inquiryId
        && approval.payload.assessedLevel == level;
    }

    // Ordered cheapest-first: the approval lookup only runs on an actual override.
    // Missing-field guards matter — an unguarded access makes the rule error (deny)
    // instead of falling through to the next clause.
    function placementLevelAllowed(inquiryId, req, res) {
      return ('currentLevel' in req ? req.currentLevel : '') == ('currentLevel' in res ? res.currentLevel : '')
        // Kindergarten placement is tier/age based, never score based: not gated.
        || (('division' in res) && res.division == 'kindergarten'
            && ('division' in req) && req.division == 'kindergarten')
        // Ordinary assessment: the score written alongside justifies this level.
        || (('currentLevel' in req)
            && ('latestPlacementScore' in req)
            && req.latestPlacementScore is number
            && req.latestPlacementScore >= 0
            && scoreImpliedLevel(req.latestPlacementScore) == req.currentLevel)
        // Approved override.
        || (('currentLevel' in req)
            && ('appliedFromApproval' in req)
            && req.appliedFromApproval is string
            && req.appliedFromApproval != ''
            && isApprovedPlacementLevelOverride(inquiryId, req.appliedFromApproval, req.currentLevel));
    }

    // ── Retroactive class attendance (OD-IL-ENF3, owner-ratified 2026-10-08) ─────────
    // `attendanceDate` is a client-supplied "YYYY-MM-DD" string that rules cannot parse,
    // so `attendanceDateTs` carries the same day as a Timestamp. A mark for a day that has
    // already ended in WITA is a retroactive backfill and needs an approved envelope.
    //
    // Honest limit (recorded in the owner-decision register): a crafted client can declare
    // a false "today" timestamp and then write a record with a wrong date. That is a
    // data-integrity problem, not a bypass of this gate; preventing it needs a server-side
    // writer, which this project does not have.
    function isRetroactiveAttendance(attendanceDateTs) {
      return request.time >= attendanceDateTs + duration.value(24, 'h');
    }

    function isApprovedRetroactiveAttendance(req) {
      return ('appliedFromApproval' in req)
        && req.appliedFromApproval is string
        && req.appliedFromApproval != ''
        && isApprovedRetroactiveBackfill(
          req.appliedFromApproval,
          req.classId,
          req.studentId,
          req.attendanceDate
        );
    }

    function isApprovedRetroactiveBackfill(approvalId, classId, studentId, attendanceDate) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'RETROACTIVE_STUDENT_ATTENDANCE'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        && approval.requestedByUid != approval.decidedByUid
        && ('approverRole' in approval)
        // The actionId is pinned above, so the permitted set is inlined rather than
        // running the generic gateAllowsApprover chain (rules-engine expression budget).
        && (approval.approverRole == 'opslead' || approval.approverRole == 'ops_lead')
        && ('payload' in approval)
        && approval.payload != null
        && approval.payload.classId == classId
        && approval.payload.studentId == studentId
        && approval.payload.attendanceDate == attendanceDate;
    }

    // OD-IL-ENF4 (owner decision 2026-10-09): a *staff* account may not be created without
    // an approved NEW_STAFF_ACCOUNT envelope. The app already provisions the profile inside
    // the approval handler, so this changes nothing about the working flow — it closes the
    // direct-creation path where an executive could mint a staff account with no decision
    // on record. Student/parent accounts are not affected (see the create rule), and the
    // invite-based self-registration path is authorised by the invite instead.
    //
    // The actionId is pinned below, so the permitted set is inlined rather than running the
    // generic gateAllowsApprover chain (rules-engine expression budget).
    function isApprovedNewStaffAccount(targetUserId, approvalId) {
      let approval = get(/databases/$(database)/documents/approvals/$(approvalId)).data;
      return approval.actionId == 'NEW_STAFF_ACCOUNT'
        && approval.status == 'approved'
        && (!('applied' in approval) || approval.applied != true)
        && approval.requestedByUid != approval.decidedByUid
        && ('approverRole' in approval)
        && (approval.approverRole == 'director' || approval.approverRole == 'vice_director')
        && ('payload' in approval)
        && approval.payload != null
        && approval.payload.uid == targetUserId;
    }

    function shiftMatchesCorrectionPayload(approvalId, reqData, resData) {
      let payload = get(/databases/$(database)/documents/approvals/$(approvalId)).data.payload;
      return !('afterData' in payload) || payload.afterData == null
        || (
          (!('clockIn' in payload.afterData) ? reqData.clockIn == resData.clockIn : reqData.clockIn == payload.afterData.clockIn)
          && (!('clockOut' in payload.afterData) ? reqData.clockOut == resData.clockOut : reqData.clockOut == payload.afterData.clockOut)
        );
    }

    function classDoc(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)).data;
    }

    function isAssignedToClass(classId) {
      let c = classDoc(classId);
      return c != null
        && signedIn()
        && (
          c.instructorId == request.auth.uid
          || ('substituteInstructorId' in c && c.substituteInstructorId == request.auth.uid)
        );
    }

    function canManageClassAttendance(classId) {
      let c = classDoc(classId);
      return c != null
        && (
          isAdmin()
          || (
            isFrontOffice()
            && isSameBranch(c)
          )
          || (
            (
              hasRole('instructor')
              || hasRole('instructorleader')
              || hasRole('instructor_leader')
            )
            && isAssignedToClass(classId)
          )
        );
    }

    function studentIsEnrolled(classId, studentId) {
      let c = classDoc(classId);
      // Firestore rules cannot safely inspect a nested field inside every
      // enrollment map. `studentIds` is the authorization roster and is
      // maintained alongside the richer `enrollments` display metadata.
      return c != null && ('studentIds' in c) && c.studentIds.hasAny([studentId]);
    }

    function validClassAttendanceIdentity(data) {
      return data.classId is string
        && data.studentId is string
        && data.attendanceDate is string
        && data.markedBy is string
        && data.markedBy == request.auth.uid;
    }

    function isParent() {
      let p = userProfile();
      return signedIn()
        && p != null
        && (!('status' in p) || (p.status != 'resigned' && p.status != 'terminated'))
        && p.role == 'parent';
    }

    function isParentOf(studentId) {
      return isParent()
        && ('childStudentIds' in userProfile())
        && userProfile().childStudentIds.hasAny([studentId])
        && exists(/databases/$(database)/documents/users/$(studentId))
        && get(/databases/$(database)/documents/users/$(studentId)).data.role == 'student'
        && isSameBranch(get(/databases/$(database)/documents/users/$(studentId)).data)
        && (!('status' in get(/databases/$(database)/documents/users/$(studentId)).data)
          || get(/databases/$(database)/documents/users/$(studentId)).data.status == 'active');
    }

    match /users/{userId} {
      allow get: if (signedIn() && userId == request.auth.uid)
        || isExecutive()
        // Broad same-branch profile read is scoped to division/operational leadership only
        // (manager + ops lead family). Plain `frontoffice` is deliberately NOT included:
        // it falls through to the allow-list clauses below so Front Office cannot read peer
        // staff, marketing, operational leadership, manager or executive profiles.
        // Keep in sync with `canGetUser` in
        // src/features/shared/securityRulesMatrix/securityRulesMatrix.helpers.js.
        || ((isManager() || isOpsLead()) && isSameBranch(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader', 'parent'] && isSameBranch(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        // Front Office requires same-branch visibility of branch-level operational staff
        // (facilities / kiosk clock-in). These roles are branch-level, not division-level, so
        // — like parents — they are exempt from the division filter. This is the only role set
        // Front Office may read beyond the academic allow-list above.
        || (isFrontDeskStaff() && resource.data.role in ['officeboy', 'cleaner'] && isSameBranch(resource.data))
        || (isParentOf(userId) && resource.data.role == 'student');
      allow list: if isExecutive()
        || (isManager() && isSameBranchStrict(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)))
        || (isStaff() && resource.data.role in ['student', 'instructor', 'instructorleader', 'instructor_leader', 'parent'] && isSameBranchStrict(resource.data) && (resource.data.role == 'parent' || isDivisionAllowedForBranchStaff(resource.data)));
      allow create: if (isExecutive()
          && (
            // Student and parent accounts are ordinary intake, not a staff appointment.
            request.resource.data.role in ['student', 'parent']
            // A staff account requires the Director's (or Vice Director's) recorded decision.
            || (('appliedFromApproval' in request.resource.data)
                && request.resource.data.appliedFromApproval is string
                && request.resource.data.appliedFromApproval != ''
                && isApprovedNewStaffAccount(userId, request.resource.data.appliedFromApproval))
          ))
        || (isFrontDeskStaff() && request.resource.data.role in ['student', 'parent'] && isSameBranch(request.resource.data)
          && (request.resource.data.role != 'student' || isDivisionAllowedForBranchStaff(request.resource.data))
          && (request.resource.data.role != 'parent'
            || !('childStudentIds' in request.resource.data)
            || request.resource.data.childStudentIds.size() == 0))
        || (signedIn()
            && userId == request.auth.uid
            && request.resource.data.inviteId is string
            && isInviteValid(request.resource.data.inviteId)
            && request.resource.data.keys().hasOnly([
              'firstName', 'lastName', 'nickname', 'gender', 'displayName', 'email',
              'role', 'branch', 'branchId', 'division', 'status', 'phone', 'dob',
              'educationLevel', 'inviteId', 'createdAt', 'photoURL'
            ]));
      allow delete: if isFrontDeskStaff() && resource.data.role in ['student', 'parent'] && isSameBranch(resource.data) && (resource.data.role != 'student' || isDivisionAllowedForBranchStaff(resource.data));
      allow update: if (
          isExecutive()
          && (
            request.resource.data.role != resource.data.role
              ? (
                  ('appliedFromApproval' in request.resource.data)
                  && request.resource.data.appliedFromApproval is string
                  && isApprovedRoleElevation(userId, request.resource.data.appliedFromApproval, request.resource.data.role)
                )
              : true
          )
          && (
            // Admins cannot terminate or resign Director or Vice Director accounts
            (isDirector() || isViceDirector())
            || !(resource.data.role in ['director', 'vice_director'])
            || !('status' in request.resource.data)
            || !(request.resource.data.status in ['resigned', 'terminated'])
          )
        )
        || ((isFrontDeskStaff() || isManager())
          && resource.data.role == 'student'
          && request.resource.data.role == 'student'
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && isDivisionAllowedForBranchStaff(resource.data)
          && isDivisionAllowedForBranchStaff(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'displayName', 'name', 'phone', 'dob', 'address', 'parentName', 'parentPhone',
              'emergencyContact', 'emergencyPhone', 'notes', 'placementTests', 'status',
              'statusUpdatedAt', 'statusUpdatedBy',
              'level', 'currentLevel', 'enrollmentDate',
              'updatedAt', 'photoURL', 'nickname', 'gender', 'nis', 'school', 'grade',
              'placeOfBirth', 'religion', 'programId', 'program', 'batchType', 'classType',
              'schoolOrJob', 'classOrSemester', 'joinedDate', 'fatherName', 'fatherJob',
              'fatherPhone', 'motherName', 'motherJob', 'motherPhone', 'referralSource',
              'rating', 'paymentPlan', 'paymentStatus', 'lastPaymentPeriod', 'lastPaymentDate',
              'lastPaymentAmount', 'lastPaymentMethod', 'paidUntil', 'branch', 'division'
            ]))
        || ((isFrontDeskStaff() || isManager())
          && resource.data.role == 'parent'
          && request.resource.data.role == 'parent'
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'updatedAt', 'status', 'branch', 'childStudentIds']))
        || (signedIn()
          && userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'phone', 'dob', 'photoURL', 'nickname']));
    }

    match /invites/{inviteId} {
      // inviteId is the invite's unguessable token. Public signup can look
      // an invite up by its exact ID, but can never list/dump the collection.
      allow get: if true;
      allow list: if isExecutive() || (isFrontOffice() && isSameBranchStrict(resource.data));

      // A newly-registered staff member may clear the one invite that
      // matches their own (just-verified) auth email; admins/executives can cancel any.
      allow delete: if isExecutive()
        || (signedIn() && resource.data.email == request.auth.token.email);

      allow create: if isExecutive()
        && (!(request.resource.data.role in ['admin', 'director', 'vice_director']) || isDirector());
    }

    match /applications/{applicationId} {
      allow get: if isExecutive() || ((isFrontOffice() || isManager() || hasRole('marketing')) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
      allow list: if isExecutive() || ((isFrontOffice() || isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data));
      allow update: if isExecutive() || (isFrontOffice() && isSameBranch(resource.data) && isSameBranch(request.resource.data) && isDivisionAllowedForBranchStaff(resource.data) && isDivisionAllowedForBranchStaff(request.resource.data) && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId));
      allow delete: if isViceDirector() || isDirector();
      allow create: if false;
    }

    match /classes/{classId} {
      allow get: if isExecutive()
        || (isStaff() && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data))
        || (isStaff() && (
            resource.data.instructorId == request.auth.uid
            || ('substituteInstructorId' in resource.data && resource.data.substituteInstructorId == request.auth.uid)
          ))
        || (signedIn() && ('studentIds' in resource.data) && resource.data.studentIds.hasAny([request.auth.uid]))
        || (isParent() && isSameBranch(resource.data) && ('childStudentIds' in userProfile()) && ('studentIds' in resource.data) && resource.data.studentIds.hasAny(userProfile().childStudentIds));
      allow list: if isExecutive()
        || (isStaff() && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data))
        || (isStaff() && (
            resource.data.instructorId == request.auth.uid
            || ('substituteInstructorId' in resource.data && resource.data.substituteInstructorId == request.auth.uid)
          ))
        || (signedIn() && ('studentIds' in resource.data) && resource.data.studentIds.hasAny([request.auth.uid]))
        || (isParent() && isSameBranchStrict(resource.data) && ('childStudentIds' in userProfile()) && ('studentIds' in resource.data) && resource.data.studentIds.hasAny(userProfile().childStudentIds));
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && isDivisionAllowedForBranchStaff(resource.data)
          && isDivisionAllowedForBranchStaff(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds', 'enrollments', 'updatedAt'])
          && (!('capacity' in resource.data) || request.resource.data.studentIds.size() <= resource.data.capacity)
          && (!('maxStudents' in resource.data) || request.resource.data.studentIds.size() <= resource.data.maxStudents));
    }

    match /todos/{todoId} {
      // Branch-lock directives by default. Executives have province-wide access.
      // Explicitly academy-wide directives (branch == 'all' or branchId == 'all') are readable by all staff.
      allow get: if isExecutive()
        || (isStaff() && (
          isSameBranch(resource.data)
          || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
          || (('branchId' in resource.data) && resource.data.branchId == 'all')
        ));
      allow list: if isExecutive()
        || (isStaff() && (
          isSameBranchStrict(resource.data)
          || (('branchId' in resource.data) && resource.data.branchId == 'all')
          || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
        ));
      // Executives and Managers issue directives; Front Office can manage desk directives in their branch
      allow create, delete: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranch(request.resource.data));
      // Executives, Managers, and Front Office can update any directive field;
      // other staff can only toggle completion status and attribution
      allow update: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isSameBranch(request.resource.data))
        || (isStaff()
            && (
              isSameBranch(resource.data)
              || (('branch' in resource.data) && (resource.data.branch == 'all' || resource.data.branch == 'All'))
              || (('branchId' in resource.data) && resource.data.branchId == 'all')
            )
            && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'completedAt', 'completedBy', 'completedByName', 'updatedAt']));
    }

    match /attendance/{attendanceId} {
      // Branch-lock attendance by default. Executives have province-wide access.
      allow get: if isExecutive()
        || (isStaff() && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      allow list: if isExecutive()
        || (isStaff() && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      // Student scans: Executives, Front Office, Instructor, and Instructor Leader; scanned person must be a student
      allow create: if (isExecutive() || isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
        && isSameBranch(request.resource.data)
        && isDivisionAllowedForBranchStaff(request.resource.data)
        && request.resource.data.userId is string
        && request.resource.data.timestamp is string
        && roleOf(request.resource.data.userId) == 'student'
        && isSameBranch(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data);
      // Double-scan idempotency: allow Front Office and Instructors to update existing day scan as long as student identity is preserved
      allow update: if isExecutive()
        || ((isFrontOffice() || hasRole('instructor') || hasRole('instructorleader') || hasRole('instructor_leader'))
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && isDivisionAllowedForBranchStaff(resource.data)
          && isDivisionAllowedForBranchStaff(request.resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.role == resource.data.role);
    }

    match /corporateEvents/{eventId} {
      // Corporate events represent internal school calendar items (meetings, trainings, closures).
      // Company-wide events (audienceType == 'all') are readable by staff across all branches.
      // Branch events (audienceType == 'branch') are branch-isolated and strictly scoped to same-branch staff.
      // Students and parents cannot read corporate events.
      allow read: if isExecutive()
        || (isStaff() && (
              resource.data.audienceType == 'all'
              || isSameBranchStrict(resource.data)
           ));
      allow create: if (isExecutive() || isManager() || isFrontOffice())
        && request.resource.data.name is string
        && request.resource.data.eventDate is string
        && request.resource.data.audienceType in ['all', 'branch', 'role', 'division']
        && (isExecutive() || (
          request.resource.data.audienceType != 'branch'
          || request.resource.data.audienceValue == userBranch()
          || (request.resource.data.audienceValue == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
          || (request.resource.data.audienceValue == 'Bone Bolango' && userBranch() == 'bone_bolango')
          || (request.resource.data.audienceValue == 'Pohuwato' && userBranch() == 'pohuwato')
          || (request.resource.data.audienceValue == 'Limboto' && userBranch() == 'limboto')
        ));
      allow update: if isExecutive()
        || (isManager() && resource.data.audienceType == 'all' && request.resource.data.audienceType == 'all')
        || ((isManager() || isFrontOffice())
          && isSameBranch(resource.data)
          && (
            request.resource.data.audienceType != 'branch'
            || request.resource.data.audienceValue == userBranch()
            || (request.resource.data.audienceValue == 'Kota Gorontalo' && userBranch() == 'kota_gorontalo')
            || (request.resource.data.audienceValue == 'Bone Bolango' && userBranch() == 'bone_bolango')
            || (request.resource.data.audienceValue == 'Pohuwato' && userBranch() == 'pohuwato')
            || (request.resource.data.audienceValue == 'Limboto' && userBranch() == 'limboto')
          ));
      allow delete: if (isManager() || isFrontOffice()) && isSameBranch(resource.data);
    }

    match /classAttendance/{attendanceId} {
      allow read: if
        isExecutive()
        || (
          (isManager() || isFrontOffice())
          && isSameBranch(classDoc(resource.data.classId))
          && isDivisionAllowedForBranchStaff(classDoc(resource.data.classId))
        )
        || (
          (
            hasRole('instructor')
            || hasRole('instructorleader')
            || hasRole('instructor_leader')
          )
          && isAssignedToClass(resource.data.classId)
        )
        // Instructor Leader branch-scope attendance monitoring (read-only).
        // Matched against the REAL class document rather than the attendance
        // document: classDoc() always resolves an actual document, so the branch
        // comparison stays sound for `list` — the lenient isSameBranch() fallback
        // documented at the top of this file treats a fieldless synthetic list doc
        // as Kota Gorontalo and would otherwise leak every branch's records.
        || (
          isInstructorLeader()
          && isSameBranch(classDoc(resource.data.classId))
        )
        || (
          signedIn()
          && resource.data.studentId == request.auth.uid
        )
        || (
          signedIn()
          && isParentOf(resource.data.studentId)
        );

      // First attendance creation only. Enforce deterministic document ID {classId}_{studentId}_{attendanceDate}.
      //
      // OD-IL-ENF3: `attendanceDateTs` is required and decides whether this is a same-day
      // mark (the historical behaviour, unchanged) or a retroactive backfill, which needs
      // an approved RETROACTIVE_STUDENT_ATTENDANCE envelope naming exactly this class,
      // student and date. Today no UI writes a past date; this arms the gate so that any
      // future backfill path is governed by construction.
      allow create: if
        attendanceId == request.resource.data.classId + '_' + request.resource.data.studentId + '_' + request.resource.data.attendanceDate
        && validClassAttendanceIdentity(request.resource.data)
        && request.resource.data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']
        && request.resource.data.method in ['SCAN', 'MANUAL', 'CLOSE_OUT']
        && request.resource.data.attendanceDateTs is timestamp
        && (
          (
            !isRetroactiveAttendance(request.resource.data.attendanceDateTs)
            && canManageClassAttendance(request.resource.data.classId)
            && studentIsEnrolled(
              request.resource.data.classId,
              request.resource.data.studentId
            )
          )
          || (
            isRetroactiveAttendance(request.resource.data.attendanceDateTs)
            && isApprovedRetroactiveAttendance(request.resource.data)
          )
        );

      // Existing records must not be overwritten by scan.
      allow update: if
        canManageClassAttendance(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.attendanceDate == resource.data.attendanceDate
        && validClassAttendanceIdentity(request.resource.data)
        && request.resource.data.method == 'MANUAL'
        && request.resource.data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'note', 'method', 'markedBy', 'markedByName', 'markedAt', 'updatedAt']);
    }

    match /payments/{paymentId} {
      allow get: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId)));
      allow list: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data));
      allow create: if (isExecutive() || (isFrontOffice() && isSameBranch(request.resource.data) && isDivisionAllowedForBranchStaff(request.resource.data)))
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.studentId is string
        && roleOf(request.resource.data.studentId) == 'student'
        && isSameBranch(get(/databases/$(database)/documents/users/$(request.resource.data.studentId)).data);
      allow update: if isExecutive()
        || (
          isFrontOffice()
          && isSameBranch(resource.data)
          && isSameBranch(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['notes', 'approvalStatus', 'referenceNumber', 'updatedAt'])
        );
    }

    match /deskInquiries/{inquiryId} {
      allow get: if isExecutive() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
      allow list: if isExecutive() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data));
      allow create: if isExecutive() || ((isManager() || isFrontOffice() || isStaff()) && isSameBranch(request.resource.data) && isDivisionAllowedForManager(request.resource.data));
      // Placement level authority (OD-IL-ENF2) needs headroom under the engine's
      // 1000-expression ceiling, and `isExecutive() || isManager() || isFrontOffice() ||
      // isStaff()` is exactly `isStaff()` (its role list is a superset of the other three,
      // and all four share the same signed-in / active-profile predicate). Collapsing it
      // removes three redundant userProfile() reads per evaluation. Behaviour is identical.
      allow update: if (isStaff()
          && isSameBranch(resource.data) && isSameBranch(request.resource.data)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && isDivisionAllowedForManager(resource.data) && isDivisionAllowedForManager(request.resource.data))
        // Placement level authority (OD-IL-ENF2). Kept last: it is the only clause here
        // that can read another document, and only when the level actually changes.
        && placementLevelAllowed(inquiryId, request.resource.data, resource.data);
      allow delete: if isViceDirector() || isDirector();
    }

    match /approvals/{approvalId} {
      allow read: if isExecutive()
        || isApproverForDoc(resource.data)
        || (signedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && (
          isStaff()
          || (
            request.resource.data.actionId == 'NEW_STAFF_ACCOUNT'
            && 'payload' in request.resource.data
            && request.resource.data.payload.uid == request.auth.uid
          )
        )
        && (
          (request.resource.data.actionId != 'STAFF_ROLE_ELEVATION' && request.resource.data.actionId != 'DISCOUNT_OR_REFUND')
          || (('approverRole' in request.resource.data) && request.resource.data.approverRole in ['director', 'vice_director'])
        )
        // Every envelope must name an approver role the ratified registry permits for its
        // actionId, so a mis-addressed ticket cannot be created in the first place.
        && ('approverRole' in request.resource.data)
        && gateAllowsApprover(request.resource.data.actionId, request.resource.data.approverRole);
      allow update: if isApproverForDoc(resource.data)
          && request.auth.uid != resource.data.requestedByUid
          && request.resource.data.requestedByUid == resource.data.requestedByUid
          && (
            (resource.data.status == 'pending'
              && request.resource.data.status in ['approved', 'rejected']
              && request.resource.data.decidedByUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'decidedBy', 'decidedByUid', 'decidedAt', 'decisionNotes', 'rejectionReason', 'updatedAt']))
            ||
            (resource.data.status == 'approved'
              && request.resource.data.status == resource.data.status
              && request.resource.data.applied == true
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['applied', 'appliedAt', 'appliedByUid', 'updatedAt']))
          )
          // The (actionId, approverRole) pair must be permitted by the ratified registry,
          // otherwise whoever writes the envelope chooses the approver. Placed last so this
          // chain is only evaluated once the cheaper conditions have passed (the rules engine
          // caps a request at 1000 evaluated expressions). Fails closed.
          && ('approverRole' in resource.data)
          && gateAllowsApprover(resource.data.actionId, resource.data.approverRole);
      allow delete: if false; // Approvals form an immutable audit trail of operational & role decisions
    }

    match /progressReports/{reportId} {
      allow get: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data))
        || (signedIn() && resource.data.instructorId == request.auth.uid)
        || (isParentOf(resource.data.studentId))
        // Instructor Leader branch-scope academic monitoring (read-only).
        // No division filter: the leader's academic scope spans both divisions
        // within the branch, mirroring the existing instructor-family behaviour on
        // /classes and /users (isDivisionAllowedForBranchStaff's role list omits
        // instructor-family roles, so a division gate would be a no-op here anyway).
        || (isInstructorLeader() && isSameBranch(resource.data));
      allow list: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForManager(resource.data))
        || (signedIn() && resource.data.instructorId == request.auth.uid)
        || (isParent() && ('childStudentIds' in userProfile()) && userProfile().childStudentIds.hasAny([resource.data.studentId]))
        || (isInstructorLeader() && isSameBranchStrict(resource.data));
      allow create: if signedIn()
        && request.resource.data.instructorId == request.auth.uid
        && request.resource.data.studentId is string
        && request.resource.data.classId is string
        && (get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.instructorId == request.auth.uid
          || (('substituteInstructorId' in get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data)
            && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.substituteInstructorId == request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.studentIds.hasAny([request.resource.data.studentId]);
      allow update, delete: if isExecutive() || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForManager(resource.data));
    }

    match /shifts/{shiftId} {
      allow get: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranch(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isExecutive()
        || ((isManager() || isFrontOffice()) && isSameBranchStrict(resource.data) && isDivisionAllowedForBranchStaff(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      // Staff scans: Admin and Front Office (reception kiosk station), for tracked roles only, new shifts start open
      allow create: if (isAdmin() || (isFrontOffice() && isSameBranch(request.resource.data) && isDivisionAllowedForBranchStaff(request.resource.data)))
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.clockIn is string
        && request.resource.data.clockIn.size() > 0
        && request.resource.data.clockOut == null
        && isTrackedShiftRole(roleOf(request.resource.data.userId))
        && isSameBranch(get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data);
      // Shift clock-out and updates: Admin or Front Office (kiosk clock-out)
      allow update: if isAdmin()
        || (isFrontOffice()
          && isSameBranch(resource.data)
          && resource.data.clockOut == null
          && request.resource.data.clockOut is string
          && request.resource.data.userId == resource.data.userId
          && (!('branch' in resource.data) || request.resource.data.branch == resource.data.branch)
          && (!('branchId' in resource.data) || request.resource.data.branchId == resource.data.branchId)
          && request.resource.data.clockIn == resource.data.clockIn
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockOut', 'updatedAt', 'cashReconciliation', 'notes', 'status', 'verifiedBy', 'verifiedAt', 'autoClosed']))
        // Approved shift self-corrections: Front Office / Manager may only apply a correction
        // already approved via the maker-checker approvals collection (dual-control enforced by rules).
        || ((isFrontOffice() || isManager())
          && isSameBranch(resource.data)
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(shiftId, request.resource.data.appliedFromApproval)
          && shiftMatchesCorrectionPayload(request.resource.data.appliedFromApproval, request.resource.data, resource.data)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clockIn', 'clockOut', 'corrected', 'reviewStatus', 'appliedFromApproval']))
        // Front Office and Manager can mark a completed/closed shift as reviewed
        || ((isFrontOffice() || isManager())
          && isSameBranch(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviewStatus']));
    }

    match /shiftAuditEvents/{eventId} {
      allow read: if isExecutive() || (isManager() && isSameBranchStrict(resource.data));
      allow create: if (isAdmin()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string)
        || ((isFrontOffice() || isManager())
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.shiftId is string
          && request.resource.data.action == 'manual_adjustment'
          && request.resource.data.appliedFromApproval is string
          && isApprovedShiftCorrection(request.resource.data.shiftId, request.resource.data.appliedFromApproval));
      allow update, delete: if false; // append-only immutable audit trail
    }

    match /staffLeave/{leaveId} {
      allow get: if isExecutive()
        || (isManager() && isSameBranch(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isExecutive()
        || (isManager() && isSameBranchStrict(resource.data))
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isExecutive()
        && request.resource.data.status == 'approved'
        && isTrackedLeaveRole(roleOf(request.resource.data.userId));
      allow update, delete: if isExecutive();
    }

    match /materials/{materialId} {
      allow read: if signedIn()
        && resource.data.createdBy == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn()
        && resource.data.createdBy == request.auth.uid;
    }

    match /errorLogs/{logId} {
      allow create: if signedIn()
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.timestamp is string
        && (!('stack' in request.resource.data) || (request.resource.data.stack is string && request.resource.data.stack.size() <= 8000))
        && (!('url' in request.resource.data) || (request.resource.data.url is string && request.resource.data.url.size() <= 1000));
      allow read, delete: if isExecutive();
      allow update: if false;
    }

    match /schoolOutreach/{schoolId} {
      // Read access is restricted to roles that have an operational need:
      // Executive (full access), Manager (oversight/reporting), Marketing (field work).
      // Instructor, Front Office, and Office Boy have no outreach business and are excluded.
      allow get: if isExecutive() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data));
      allow list: if isExecutive() || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
      allow create: if (isExecutive() || ((isManager() || hasRole('marketing')) && isSameBranch(request.resource.data)))
        && request.resource.data.name is string
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update: if (isExecutive() || ((isManager() || hasRole('marketing')) && isSameBranch(resource.data) && isSameBranch(request.resource.data)))
        && (!('createdBy' in resource.data) || request.resource.data.createdBy == resource.data.createdBy)
        && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
      match /visits/{visitId} {
        // Enforce strict branch check so visits are consistently isolated per branch across direct and collectionGroup queries
        allow read: if isExecutive()
          || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
        allow create: if (isExecutive() || ((isManager() || hasRole('marketing'))
            && isSameBranchStrict(request.resource.data)
            && isSameBranch(get(/databases/$(database)/documents/schoolOutreach/$(schoolId)).data)))
          && request.resource.data.visitDate is string
          && request.resource.data.contactName is string
          && request.resource.data.contactRole is string
          && request.resource.data.branchId is string
          && request.resource.data.branch is string
          && request.resource.data.source == 'schoolOutreach';
        allow update: if isAdmin();
      }
    }

    match /{path=**}/visits/{visitId} {
      // Collection-group query matcher for outreach visits across schools
      allow read: if isExecutive()
        || ((isManager() || hasRole('marketing')) && isSameBranchStrict(resource.data));
      allow create: if (isExecutive()
          || ((isManager() || hasRole('marketing')) && isSameBranchStrict(request.resource.data)))
        && request.resource.data.visitDate is string
        && request.resource.data.contactName is string
        && request.resource.data.contactRole is string
        && request.resource.data.branchId is string
        && request.resource.data.branch is string
        && request.resource.data.source == 'schoolOutreach';
      allow update: if isAdmin();
    }

    match /kioskDevices/{deviceId} {
      allow get: if isExecutive()
        || ((isFrontOffice() || isManager()) && isSameBranch(resource.data));
      allow list: if isExecutive()
        || ((isFrontOffice() || isManager()) && isSameBranchStrict(resource.data));
      allow write: if false; // Provisioning and revocation managed server-side
    }

    match /kioskChallenges/{deviceId} {
      allow read, write: if false; // Ephemeral challenge nonces strictly managed server-side
    }

    match /kioskAuditEvents/{eventId} {
      allow read: if isExecutive() || (isManager() && isSameBranchStrict(resource.data));
      allow write: if false; // Append-only audit events created server-side
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# ==============================================================================
# MY LIBERTY Portal — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env (or .env.local for local overrides):
#   cp .env.example .env
#
# NOTE: All variables prefixed with VITE_ are exposed to client-side bundles.
# Never place server-only secrets or private service-account keys in this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client SDK Configuration (MANDATORY)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdef
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# 2. Firebase App Check & reCAPTCHA v3 (OPTIONAL / PRODUCTION)
# Protects backend APIs and Firestore from automated abuse.
# ------------------------------------------------------------------------------
# reCAPTCHA v3 site key for production App Check verification:
VITE_RECAPTCHA_SITE_KEY=

# Local development debug token (avoids reCAPTCHA verification on localhost):
# Generate a debug token in Firebase Console -> App Check -> Apps -> Manage debug tokens
VITE_APPCHECK_DEBUG_TOKEN=

# ------------------------------------------------------------------------------
# 3. Cloudflare AI Proxy Worker (OPTIONAL)
# Edge worker URL handling AI assistant completions for staff and instructors:
# ------------------------------------------------------------------------------
VITE_AI_WORKER_URL=https://myliberty-ai-proxy.workers.dev

# ------------------------------------------------------------------------------
# 4. Cloudinary Image Upload (OPTIONAL)
# Used for photo uploads (class activities, student avatars):
# ------------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=ml_default

# ------------------------------------------------------------------------------
# 5. Local Dev Quick Switcher (DEVELOPMENT ONLY)
# Optional password override for 1-click test account switching in development.
# Only enabled when running under `npm run dev` (import.meta.env.DEV).
# ------------------------------------------------------------------------------
VITE_DEV_TEST_PASSWORD=
